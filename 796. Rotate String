class Solution {
public:
    bool rotateString(string s, string goal) {
        int n = s.length();
        if (n != goal.length()){
            return false;
        }
        for (int i = 0; i < n; i++){
            char first = s[0];
            s = s.substr(1) + first;

            if (s == goal){
                return true;
            }

        }
        return false;
    }
};
